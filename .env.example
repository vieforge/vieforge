# TierForge Hybrid AI Agent Harness — Environment Configuration
# Copy to .env and adjust for your local workstation.

# --- Tier 2: Local LLM (Ollama or OpenAI-compatible endpoint) ---
TIERFORGE_LLM_BASE_URL=http://127.0.0.1:11434
TIERFORGE_LLM_API_KEY=ollama
TIERFORGE_LLM_MODEL=qwen2.5:7b
# Force immediate VRAM unload after each request (0 = unload immediately)
TIERFORGE_OLLAMA_KEEP_ALIVE=0
TIERFORGE_LLM_TIMEOUT_SEC=120

# --- State & Checkpointing (SQLite) ---
TIERFORGE_STATE_DB=data/tierforge_state.db
TIERFORGE_LOG_DIR=logs
TIERFORGE_QA_LOG=logs/qa_feedback.jsonl

# --- Budget & Pricing Guardrails ---
TIERFORGE_PRICING_CONFIG=config/pricing.example.json
TIERFORGE_BUDGET_CONFIG=config/budget_limits.json
TIERFORGE_MAX_JOB_USD=5.00
TIERFORGE_DAILY_USD_CAP=20.00
TIERFORGE_MAX_RETRY_PER_ITEM=2

# --- Tier 3: Optional Hardware / VRAM Guard ---
# Minimum free VRAM (MB) required before launching a GPU subprocess
TIERFORGE_MIN_FREE_VRAM_MB=4096
